# VibeLedger Target Environment Configuration Example
# Copy this file to .env and configure the variables for your target runtime.

# Environment: development / test / staging / production (Destructive tests require 'test'; migrations refuse 'production')
ENVIRONMENT=staging

# PostgreSQL connection string (Use isolated staging database / Supabase pooler)
DATABASE_URL=postgresql://postgres.example:password@aws-1-region.pooler.supabase.com:6543/postgres

# Target schema (Must NOT be public, extensions, or a system schema)
DB_SCHEMA=vibeledger_staging

# Gemini API Key (Required for full readiness and multimodal expense ingestion)
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication Configuration (For staging: HS256 HMAC signing with shared secret)
AUTH_PUBLIC_KEY=your_staging_shared_secret_min_32_chars_long
AUTH_ALGORITHMS=["HS256"]
AUTH_ISSUER=vibeledger-staging
AUTH_AUDIENCE=vibeledger-api
AUTH_JWKS_URL=

# Media File Size Limits (in bytes)
MAX_EXPENSE_IMAGE_BYTES=10485760
MAX_STATEMENT_PDF_BYTES=20971520

# Reference Foreign Exchange Service
FX_API_BASE_URL=https://api.frankfurter.app
FX_HTTP_TIMEOUT_SECONDS=5.0

# Staging Bootstrap Identity (Single source of truth for initial staging setup)
STAGING_LEDGER_START_DATE=2026-08-01
STAGING_OWNER_AUTH_SUBJECT=staging_owner_user
