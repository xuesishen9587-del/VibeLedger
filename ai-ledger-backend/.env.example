# VibeLedger Environment Configuration Example
# Copy this file to .env and configure the variables.

# Environment: development / test / production (Tests will refuse to run in production)
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibeledger

# Target schema (must NOT be public or empty)
DB_SCHEMA=vibeledger_target

# Gemini API Key (optional for Phase 0/1)
GEMINI_API_KEY=
